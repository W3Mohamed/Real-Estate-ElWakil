{% extends 'base.html.twig' %}

{% block title %}Connexion Promoteurs - El Wakil immobilier{% endblock %}

{% block body %}
<div class="py-12 bg-gray-50 min-h-[calc(100vh-80px)]">
    <div class="container mx-auto px-4">
        <div class="max-w-md mx-auto bg-white rounded-xl shadow-lg overflow-hidden border border-gray-100">
            <div class="p-8">
                <h2 class="text-2xl font-bold text-center text-gray-800 mb-8 uppercase tracking-wide">
                    Connexion <span class="text-yellow-500">Promoteurs</span>
                </h2>

                {% if error %}
                    <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded shadow-sm" role="alert">
                        <p class="text-sm">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                    </div>
                {% endif %}

                <form action="{{ path('app_promoteur_login') }}" method="post" class="space-y-6">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    
                    <div>
                        <label for="username" class="block text-sm font-semibold text-gray-700 mb-2">Nom d'utilisateur</label>
                        <input type="text" id="username" name="_username" value="{{ last_username }}" 
                               class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500 outline-none transition duration-200" 
                               placeholder="Votre nom" required>
                    </div>

                    <div>
                        <label for="password" class="block text-sm font-semibold text-gray-700 mb-2">Mot de passe</label>
                        <input type="password" id="password" name="_password" 
                               class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500 outline-none transition duration-200" 
                               placeholder="••••••••" required>
                    </div>

                    <button type="submit" 
                            class="w-full bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-3 px-4 rounded-lg shadow-md hover:shadow-lg transition duration-300 transform hover:-translate-y-0.5">
                        Se connecter
                    </button>
                </form>

                <div class="mt-8 text-center border-t border-gray-100 pt-6">
                    <p class="text-sm text-gray-600">
                        Problème de connexion ? 
                        <a href="tel:{{parametres.telephone}}" class="text-yellow-600 font-semibold hover:underline">Contactez le support</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}